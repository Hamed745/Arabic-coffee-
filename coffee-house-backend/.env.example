PORT=5000
AUTH_TOKEN_SECRET=change-me-in-production

# Admin recovery address (must match the email used in "Forgot password")
ADMIN_RECOVERY_EMAIL=ha6456278@gmail.com

# Real inbox (required for POST /api/auth/admin-recovery/send-code-email):
# Gmail App Password on the same account as SMTP_USER.
# For POST /api/auth/admin-request-password-reset only: leave SMTP_PASS empty in dev to use Ethereal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=

# Optional: different From header (defaults to SMTP_USER)
# SMTP_FROM=Coffee House <youraddress@gmail.com>
